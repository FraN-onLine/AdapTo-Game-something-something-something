[sub_resource type="Resource" id="Resource_1"]
script = ExtResource("1_item")
id = "COM_01"
term = "Component Diagram"
keyword = "module"
definition = "Shows software parts and their dependencies to describe system structure at a high level."
simple_terms = "Visual map of connected program parts"
examples = ["user module", "data layer", "auth service"]
accepted_terms = ["UML"]
difficulty = 1
related_to = ["design", "process", "quality", "management", "estimation"]
tof_statement = {
"false": "It shows execution timing only.",
"true": "It models structural relationships."
}
type_of_information = ["definition", "explain", "apply"]

[sub_resource type="Resource" id="Resource_2"]
