examples = ["TLS/SSL encryption.", "VPN secure tunnels.", "Secure protocols for communication."]
accepted_terms = ["Data in Motion"]
difficulty = 1
related_to = ["Information Security Blueprint", "Information States"]
tof_statement = {
"false": "Information in transit is data that is stored on a server.", 
"true": "Information in transit is data that is being sent across a network."
}
type_of_information = ["definition", "explain", "apply"]
metadata/_custom_type_script = "uid://dadne10e1geqd"

