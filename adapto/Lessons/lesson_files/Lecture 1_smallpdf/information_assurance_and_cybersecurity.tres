[sub_resource type="Resource" id="Resource_1"]
script = ExtResource("1_7hrog")
id = "1"
term = "MSR Model"
keyword = "MSR Model"
definition = "A framework that aligns security measures with real-world applications of information assurance, focusing on states of information and countermeasures."
simple_terms = "A security model for information."
examples = ["Securing data across storage, transmission, and processing.", "Using countermeasures like availability, integrity, and authentication.", "Offering core services like confidentiality and nonrepudiation."]
accepted_terms = ["Maconachy-Schou-Ragsdale Model"]
difficulty = 2
related_to = ["Information Assurance", "Cybersecurity"]
tof_statement = {
"false": "The MSR Model only focuses on the confidentiality of data.", 
"true": "The MSR Model considers the states of information and the countermeasures needed for security."
}
type_of_information = ["definition", "explain", "apply"]
metadata/_custom_type_script = "uid://dadne10e1geqd"

[sub_resource type="Resource" id="Resource_2"]
script = ExtResource("1_7hrog")
id = "2"
term = "Information States"
keyword = "Information States"
definition = "The different conditions under which information exists and is processed, including storage, transmission, and processing."
simple_terms = "Where and how data is."
examples = ["Data at rest (storage).", "Data in motion (transmission).", "Data in use (processing)."]
accepted_terms = []
difficulty = 1
related_to = ["MSR Model"]
tof_statement = {
"false": "The three information states are encryption, decryption, and hashing.", 
"true": "The three information states in the MSR model are storage, transmission, and processing."
}
type_of_information = ["definition", "explain", "apply"]
metadata/_custom_type_script = "uid://dadne10e1geqd"

[sub_resource type="Resource" id="Resource_3"]
