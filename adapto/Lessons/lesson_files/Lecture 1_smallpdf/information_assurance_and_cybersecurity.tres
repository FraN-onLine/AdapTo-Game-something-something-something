id = "71"
term = "Information in Storage"
keyword = "Information in Storage"
definition = "Refers to data that is stored physically or digitally, requiring security measures like encryption and physical vaulting."
simple_terms = "Data at rest."
examples = ["Database encryption.", "Physical vaulting of media.", "Securing hard drives."]
accepted_terms = ["Data at Rest"]
difficulty = 1
related_to = ["Information Security Blueprint", "Information States"]
tof_statement = {
"false": "Information in storage refers to data that is currently being accessed by users.", 
"true": "Information in storage refers to data that is not actively being transmitted or processed."
}
type_of_information = ["definition", "explain", "apply"]
metadata/_custom_type_script = "uid://dadne10e1geqd"

