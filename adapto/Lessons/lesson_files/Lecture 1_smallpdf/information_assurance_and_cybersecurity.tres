keyword = "Bell-LaPadula Model"
definition = "A theoretical model for confidentiality that prevents information flow from higher security levels to lower ones ('no read up, no write down')."
simple_terms = "Confidentiality security model."
examples = ["Used in military/government.", "Prevents data leaks.", "Focuses on preventing unauthorized reading or writing."]
accepted_terms = []
difficulty = 3
related_to = ["Theoretical Models", "Confidentiality"]
tof_statement = {
"false": "The Bell-LaPadula model focuses on ensuring data availability.", 
"true": "The Bell-LaPadula model is designed to ensure confidentiality by controlling information flow."
}
type_of_information = ["definition", "explain", "apply"]
metadata/_custom_type_script = "uid://dadne10e1geqd"

[sub_resource type="Resource" id="Resource_69"]
script = ExtResource("1_7hrog")
id = "69"
term = "Biba Integrity Model"
keyword = "Biba Integrity Model"
definition = "A theoretical model for integrity that prevents information flow from lower integrity levels to higher ones ('no read down, no write up')."
simple_terms = "Integrity security model."
examples = ["Used in finance/research.", "Ensures data is not corrupted by low-integrity sources.", "Focuses on preventing unauthorized writing or reading from lower levels."]
accepted_terms = []
difficulty = 3
related_to = ["Theoretical Models", "Integrity"]
tof_statement = {
"false": "The Biba Integrity Model is primarily concerned with user authentication.", 
"true": "The Biba Integrity Model aims to protect data integrity by controlling information flow."
}
type_of_information = ["definition", "explain", "apply"]
metadata/_custom_type_script = "uid://dadne10e1geqd"

[sub_resource type="Resource" id="Resource_70"]
script = ExtResource("1_7hrog")
id = "70"
term = "Clark-Wilson Model"
keyword = "Clark-Wilson Model"
definition = "A theoretical model that focuses on the separation of duties to prevent internal fraud and ensure data integrity."
simple_terms = "Separation of duties model."
examples = ["Focuses on preventing internal fraud.", "Ensures data integrity through distinct roles.", "Requires certified integrity."]
accepted_terms = []
difficulty = 3
related_to = ["Theoretical Models", "Integrity", "Fraud Prevention"]
tof_statement = {
"false": "The Clark-Wilson model focuses on preventing external cyberattacks.", 
"true": "The Clark-Wilson model emphasizes separation of duties to prevent internal fraud."
}
type_of_information = ["definition", "explain", "apply"]
metadata/_custom_type_script = "uid://dadne10e1geqd"

[sub_resource type="Resource" id="Resource_71"]
