{"items":[{"id":"COM_01","term":"Component Diagram","keyword":"module","definition":"Shows software parts and their dependencies to describe system structure at a high level.","simple_terms":"Visual map of connected program parts","examples":["user module","data layer","auth service"],"accepted_terms":["UML"],"difficulty":1,"related_to":["design","process","quality","management","estimation"],"type_of_information":["definition","explain","apply"],"tof_statement":{"true":"It models structural relationships.","false":"It shows execution timing only."}},{"id":"COM_02","term":"Component Interface","keyword":"contract","definition":"Defines how a software part communicates with other parts through exposed services.","simple_terms":"Rules for interaction between modules","examples":["login api","save action","fetch data"],"accepted_terms":[],"difficulty":1,"related_to":["design","process","quality","management","estimation"],"type_of_information":["definition","explain","apply"],"tof_statement":{"true":"Interfaces expose available services.","false":"Interfaces store user data."}},{"id":"COM_03","term":"Provided Service","keyword":"service","definition":"Represents functionality offered by a software part for use by another part.","simple_terms":"Feature made available for outside use","examples":["send email","get report","save order"],"accepted_terms":[],"difficulty":1,"related_to":["design","process","quality","management","estimation"],"type_of_information":["definition","explain","apply"],"tof_statement":{"true":"It offers functionality outward.","false":"It hides all operations."}},{"id":"COM_04","term":"Required Service","keyword":"dependency","definition":"Represents functionality needed from another software part to complete its tasks.","simple_terms":"Needed feature from another program part","examples":["db access","auth check","file read"],"accepted_terms":[],"difficulty":1,"related_to":["design","process","quality","management","estimation"],"type_of_information":["definition","explain","apply"],"tof_statement":{"true":"It depends on external functionality.","false":"It works with no outside support."}},{"id":"COM_05","term":"Package Diagram","keyword":"grouping","definition":"Organizes software elements into logical containers to simplify structure understanding.","simple_terms":"Grouped sets of related code units","examples":["data pack","ui pack","logic pack"],"accepted_terms":["UML"],"difficulty":1,"related_to":["design","process","quality","management","estimation"],"type_of_information":["definition","explain","apply"],"tof_statement":{"true":"It groups related elements.","false":"It measures performance speed."}},{"id":"COM_06","term":"Package Dependency","keyword":"linkage","definition":"Shows how grouped software units rely on each other for functionality or access.","simple_terms":"Connections between grouped code blocks","examples":["ui to api","api to db","core to util"],"accepted_terms":[],"difficulty":1,"related_to":["design","process","quality","management","estimation"],"type_of_information":["definition","explain","apply"],"tof_statement":{"true":"It reveals coupling between groups.","false":"It shows user workflows."}},{"id":"COM_07","term":"Layered Design","keyword":"layers","definition":"Separates software into levels so responsibilities stay organized and maintainable.","simple_terms":"Stacked responsibility levels in software","examples":["ui layer","logic tier","data tier"],"accepted_terms":[],"difficulty":1,"related_to":["design","process","quality","management","estimation"],"type_of_information":["definition","explain","apply"],"tof_statement":{"true":"It improves separation of concerns.","false":"It removes all dependencies."}},{"id":"COM_08","term":"Module Coupling","keyword":"coupling","definition":"Measures how strongly software parts depend on one another in a design.","simple_terms":"Strength of connection between code parts","examples":["tight link","shared file","direct call"],"accepted_terms":[],"difficulty":1,"related_to":["design","process","quality","management","estimation"],"type_of_information":["definition","explain","apply"],"tof_statement":{"true":"Lower coupling is often preferred.","false":"Higher coupling improves reuse."}},{"id":"COM_09","term":"Module Cohesion","keyword":"cohesion","definition":"Measures how closely related the responsibilities inside one software part are.","simple_terms":"Focus of responsibilities inside one unit","examples":["single task","clear goal","one purpose"],"accepted_terms":[],"difficulty":1,"related_to":["design","process","quality","management","estimation"],"type_of_information":["definition","explain","apply"],"tof_statement":{"true":"Higher cohesion improves clarity.","false":"It increases unrelated functions."}},{"id":"COM_10","term":"Deployment Mapping","keyword":"mapping","definition":"Relates software parts to physical environments where they will run or be hosted.","simple_terms":"Placement of program parts on machines","examples":["web server","cloud node","local host"],"accepted_terms":[],"difficulty":1,"related_to":["design","process","quality","management","estimation"],"type_of_information":["definition","explain","apply"],"tof_statement":{"true":"It connects software to hardware.","false":"It defines user stories."}},{"id":"SEQ_01","term":"Sequence Diagram","keyword":"timeline","definition":"Shows ordered interactions between objects over time during a system operation.","simple_terms":"Message flow arranged by execution order","examples":["login flow","checkout run","search flow"],"accepted_terms":["UML"],"difficulty":1,"related_to":["design","process","quality","management","estimation"],"type_of_information":["definition","explain","apply"],"tof_statement":{"true":"It focuses on interaction order.","false":"It groups source files."}},{"id":"SEQ_02","term":"Lifeline Object","keyword":"object","definition":"Represents an active participant in an interaction scenario from start to finish.","simple_terms":"Participant existing during a scenario","examples":["user actor","cart item","db object"],"accepted_terms":[],"difficulty":1,"related_to":["design","process","quality","management","estimation"],"type_of_information":["definition","explain","apply"],"tof_statement":{"true":"It shows participant presence over time.","false":"It measures software cost."}},{"id":"SEQ_03","term":"Activation Bar","keyword":"activity","definition":"Shows the period when an object performs an operation in a sequence interaction.","simple_terms":"Time span of active task execution","examples":["run task","save file","send data"],"accepted_terms":[],"difficulty":1,"related_to":["design","process","quality","management","estimation"],"type_of_information":["definition","explain","apply"],"tof_statement":{"true":"It marks active processing time.","false":"It stores requirements."}},{"id":"SEQ_04","term":"Message Call","keyword":"message","definition":"Represents communication sent from one participant to another to request behavior.","simple_terms":"Signal passed between participants","examples":["call save","load user","send alert"],"accepted_terms":[],"difficulty":1,"related_to":["design","process","quality","management","estimation"],"type_of_information":["definition","explain","apply"],"tof_statement":{"true":"It triggers behavior in another object.","false":"It defines database tables."}},{"id":"SEQ_05","term":"Return Message","keyword":"response","definition":"Shows information sent back after an operation finishes in an interaction.","simple_terms":"Reply sent after requested work ends","examples":["ok result","error note","user data"],"accepted_terms":[],"difficulty":1,"related_to":["design","process","quality","management","estimation"],"type_of_information":["definition","explain","apply"],"tof_statement":{"true":"It carries completion results.","false":"It starts a new process."}},{"id":"SEQ_06","term":"Synchronous Call","keyword":"waiting","definition":"A request where the sender pauses until the receiver completes the requested work.","simple_terms":"Request that blocks until done","examples":["save sync","read sync","auth sync"],"accepted_terms":[],"difficulty":1,"related_to":["design","process","quality","management","estimation"],"type_of_information":["definition","explain","apply"],"tof_statement":{"true":"Sender waits for completion.","false":"Sender continues immediately."}},{"id":"SEQ_07","term":"Asynchronous Call","keyword":"parallel","definition":"A request where the sender continues work without waiting for the receiver to finish.","simple_terms":"Request that continues without waiting","examples":["send mail","push log","queue task"],"accepted_terms":[],"difficulty":1,"related_to":["design","process","quality","management","estimation"],"type_of_information":["definition","explain","apply"],"tof_statement":{"true":"Sender does not block.","false":"Sender must pause."}},{"id":"SEQ_08","term":"Interaction Fragment","keyword":"branching","definition":"Groups conditions or loops in message flows to model alternative execution paths.","simple_terms":"Conditional or repeated flow sections","examples":["if branch","loop case","alt path"],"accepted_terms":[],"difficulty":1,"related_to":["design","process","quality","management","estimation"],"type_of_information":["definition","explain","apply"],"tof_statement":{"true":"It models choices and loops.","false":"It estimates effort."}},{"id":"SEQ_09","term":"Actor Role","keyword":"userrole","definition":"Represents an external person or system that interacts with the software behavior.","simple_terms":"Outside participant using the system","examples":["buyer role","admin role","guest role"],"accepted_terms":[],"difficulty":1,"related_to":["design","process","quality","management","estimation"],"type_of_information":["definition","explain","apply"],"tof_statement":{"true":"It starts or receives interactions.","false":"It compiles source code."}},{"id":"SEQ_10","term":"Interaction Scenario","keyword":"scenario","definition":"A specific use case flow showing how participants collaborate to complete a task.","simple_terms":"Detailed example of system collaboration","examples":["buy item","book room","reset pass"],"accepted_terms":[],"difficulty":1,"related_to":["design","process","quality","management","estimation"],"type_of_information":["definition","explain","apply"],"tof_statement":{"true":"It demonstrates one use case path.","false":"It replaces testing plans."}},{"id":"SPI_01","term":"Process Improvement","keyword":"refine","definition":"The practice of analyzing and enhancing software workflows for better efficiency and quality.","simple_terms":"Making development steps better over time","examples":["faster build","less bugs","clear flow"],"accepted_terms":[],"difficulty":1,"related_to":["design","process","quality","management","estimation"],"type_of_information":["definition","explain","apply"],"tof_statement":{"true":"It aims to optimize workflow.","false":"It ignores quality issues."}},{"id":"SPI_02","term":"Capability Maturity","keyword":"maturity","definition":"A measure of how well an organization manages and improves software processes.","simple_terms":"Level of process discipline and control","examples":["basic level","managed work","optimized"],"accepted_terms":["CMMI"],"difficulty":1,"related_to":["design","process","quality","management","estimation"],"type_of_information":["definition","explain","apply"],"tof_statement":{"true":"Higher levels show stronger control.","false":"It tracks hardware inventory."}},{"id":"SPI_03","term":"Initial Level","keyword":"chaotic","definition":"The first maturity stage where work is unpredictable and depends on individual effort.","simple_terms":"Unstructured and inconsistent work style","examples":["ad hoc dev","no rules","random fix"],"accepted_terms":[],"difficulty":1,"related_to":["design","process","quality","management","estimation"],"type_of_information":["definition","explain","apply"],"tof_statement":{"true":"Processes are often unstable.","false":"Processes are optimized."}},{"id":"SPI_04","term":"Managed Level","keyword":"tracked","definition":"A maturity stage where projects are planned, monitored, and controlled consistently.","simple_terms":"Work is planned and progress tracked","examples":["task board","time logs","reviews"],"accepted_terms":[],"difficulty":1,"related_to":["design","process","quality","management","estimation"],"type_of_information":["definition","explain","apply"],"tof_statement":{"true":"Project controls are established.","false":"No planning exists."}},{"id":"SPI_05","term":"Defined Level","keyword":"standard","definition":"A maturity stage where organization processes are documented and standardized for teams.","simple_terms":"Shared methods used across teams","examples":["team guide","coding rule","process map"],"accepted_terms":[],"difficulty":1,"related_to":["design","process","quality","management","estimation"],"type_of_information":["definition","explain","apply"],"tof_statement":{"true":"Processes are documented organization wide.","false":"Processes are random."}},{"id":"SPI_06","term":"Quantitative Level","keyword":"metrics","definition":"A maturity stage using measured data to control and predict process performance.","simple_terms":"Using numbers to guide work quality","examples":["bug count","lead time","test rate"],"accepted_terms":[],"difficulty":1,"related_to":["design","process","quality","management","estimation"],"type_of_information":["definition","explain","apply"],"tof_statement":{"true":"Data drives process decisions.","false":"Decisions ignore measurement."}},{"id":"SPI_07","term":"Optimizing Level","keyword":"optimize","definition":"The highest maturity stage focused on continuous improvement and defect prevention.","simple_terms":"Constant improvement using feedback","examples":["root fix","better flow","less waste"],"accepted_terms":[],"difficulty":1,"related_to":["design","process","quality","management","estimation"],"type_of_information":["definition","explain","apply"],"tof_statement":{"true":"Improvement is continuous.","false":"Changes are avoided."}},{"id":"SPI_08","term":"Root Cause Review","keyword":"analysis","definition":"Examines defects to find the original reason and prevent the same issue later.","simple_terms":"Finding the main reason behind issues","examples":["bug source","late task","wrong spec"],"accepted_terms":[],"difficulty":1,"related_to":["design","process","quality","management","estimation"],"type_of_information":["definition","explain","apply"],"tof_statement":{"true":"It helps prevent repeated issues.","false":"It adds random changes."}},{"id":"SPI_09","term":"Process Audit","keyword":"audit","definition":"A formal check to ensure software activities follow defined methods and standards.","simple_terms":"Inspection of how work is performed","examples":["code audit","plan audit","test audit"],"accepted_terms":[],"difficulty":1,"related_to":["design","process","quality","management","estimation"],"type_of_information":["definition","explain","apply"],"tof_statement":{"true":"It verifies compliance with standards.","false":"It replaces coding."}},{"id":"SPI_10","term":"Continuous Improvement","keyword":"kaizen","definition":"An ongoing effort to make software practices better through repeated small changes.","simple_terms":"Regular upgrades to work practices","examples":["daily fix","team review","better test"],"accepted_terms":[],"difficulty":1,"related_to":["design","process","quality","management","estimation"],"type_of_information":["definition","explain","apply"],"tof_statement":{"true":"Small changes accumulate over time.","false":"Improvement happens once only."}},{"id":"CCM_01","term":"Change Management","keyword":"change","definition":"Controls requested modifications to software so impacts are reviewed before approval.","simple_terms":"Handling updates in a controlled way","examples":["feature add","bug fix","scope edit"],"accepted_terms":[],"difficulty":1,"related_to":["design","process","quality","management","estimation"],"type_of_information":["definition","explain","apply"],"tof_statement":{"true":"Changes are reviewed before action.","false":"Changes happen without approval."}},{"id":"CCM_02","term":"Configuration Management","keyword":"version","definition":"Tracks software items and versions to keep development organized and consistent.","simple_terms":"Keeping files and versions organized","examples":["code repo","build file","config set"],"accepted_terms":["CM"],"difficulty":1,"related_to":["design","process","quality","management","estimation"],"type_of_information":["definition","explain","apply"],"tof_statement":{"true":"It controls software artifacts.","false":"It removes documentation."}},{"id":"CCM_03","term":"Version Control","keyword":"history","definition":"Records file changes over time so teams can review, restore, or merge work.","simple_terms":"Timeline of code changes and recovery","examples":["git log","merge code","undo file"],"accepted_terms":["Git"],"difficulty":1,"related_to":["design","process","quality","management","estimation"],"type_of_information":["definition","explain","apply"],"tof_statement":{"true":"It stores change history.","false":"It deletes all revisions."}},{"id":"CCM_04","term":"Baseline Record","keyword":"baseline","definition":"A fixed reference version used to compare future changes and maintain consistency.","simple_terms":"Approved starting point for comparison","examples":["release one","stable build","gold copy"],"accepted_terms":[],"difficulty":1,"related_to":["design","process","quality","management","estimation"],"type_of_information":["definition","explain","apply"],"tof_statement":{"true":"It serves as a reference state.","false":"It is always temporary."}},{"id":"CCM_05","term":"Change Request","keyword":"request","definition":"A documented proposal describing a modification needed in software or its process.","simple_terms":"Formal proposal for making updates","examples":["new report","fix login","edit rule"],"accepted_terms":["CR"],"difficulty":1,"related_to":["design","process","quality","management","estimation"],"type_of_information":["definition","explain","apply"],"tof_statement":{"true":"It starts formal modification review.","false":"It deploys software directly."}},{"id":"CCM_06","term":"Impact Analysis","keyword":"impact","definition":"Evaluates how a proposed software change affects cost, time, quality, and risk.","simple_terms":"Checking effects before making updates","examples":["cost rise","delay risk","bug chance"],"accepted_terms":[],"difficulty":1,"related_to":["design","process","quality","management","estimation"],"type_of_information":["definition","explain","apply"],"tof_statement":{"true":"It studies consequences of change.","false":"It skips planning."}},{"id":"CCM_07","term":"Build Management","keyword":"build","definition":"Controls how software is compiled and packaged into deliverable executable versions.","simple_terms":"Managing creation of runnable software","examples":["night build","release zip","test build"],"accepted_terms":[],"difficulty":1,"related_to":["design","process","quality","management","estimation"],"type_of_information":["definition","explain","apply"],"tof_statement":{"true":"It organizes software packaging.","false":"It writes user manuals."}},{"id":"CCM_08","term":"Release Planning","keyword":"release","definition":"Schedules software delivery versions and decides which changes are included each time.","simple_terms":"Planning what goes into each delivery","examples":["version one","patch set","major drop"],"accepted_terms":[],"difficulty":1,"related_to":["design","process","quality","management","estimation"],"type_of_information":["definition","explain","apply"],"tof_statement":{"true":"It organizes product delivery timing.","false":"It removes testing."}},{"id":"CCM_09","term":"Branch Strategy","keyword":"branch","definition":"Defines how code lines are separated and merged to support team collaboration.","simple_terms":"Rules for parallel code development","examples":["main line","dev branch","hotfix path"],"accepted_terms":[],"difficulty":1,"related_to":["design","process","quality","management","estimation"],"type_of_information":["definition","explain","apply"],"tof_statement":{"true":"It manages parallel work streams.","false":"It replaces requirement analysis."}},{"id":"CCM_10","term":"Rollback Plan","keyword":"revert","definition":"A recovery plan to restore a previous stable software version after a failed change.","simple_terms":"Way to return to a working version","examples":["undo patch","old build","safe state"],"accepted_terms":[],"difficulty":1,"related_to":["design","process","quality","management","estimation"],"type_of_information":["definition","explain","apply"],"tof_statement":{"true":"It supports safe recovery.","false":"It increases deployment risk."}},{"id":"TRE_01","term":"Cloud Native Development","keyword":"cloud","definition":"Builds software for scalable cloud environments using services, containers, and automation.","simple_terms":"Creating apps made for online platforms","examples":["cloud app","web scale","auto deploy"],"accepted_terms":[],"difficulty":1,"related_to":["design","process","quality","management","estimation"],"type_of_information":["definition","explain","apply"],"tof_statement":{"true":"It favors scalable online systems.","false":"It avoids automation."}},{"id":"TRE_02","term":"Artificial Intelligence Tools","keyword":"ai","definition":"Uses smart systems to assist coding, testing, analysis, and decision making in projects.","simple_terms":"Machine help for software tasks","examples":["code assist","bug detect","smart test"],"accepted_terms":["AI"],"difficulty":1,"related_to":["design","process","quality","management","estimation"],"type_of_information":["definition","explain","apply"],"tof_statement":{"true":"It supports automation and insight.","false":"It replaces all developers."}},{"id":"TRE_03","term":"Low Code Platforms","keyword":"visual","definition":"Allow software creation with minimal manual coding through drag and drop tools.","simple_terms":"Building apps with fewer typed commands","examples":["form app","workflow app","portal app"],"accepted_terms":[],"difficulty":1,"related_to":["design","process","quality","management","estimation"],"type_of_information":["definition","explain","apply"],"tof_statement":{"true":"They reduce coding effort.","false":"They require full manual coding."}},{"id":"TRE_04","term":"Devops Practice","keyword":"devops","definition":"Combines development and operations to speed delivery through automation and collaboration.","simple_terms":"Joining coding and deployment teamwork","examples":["auto test","fast deploy","shared ops"],"accepted_terms":["DevOps"],"difficulty":1,"related_to":["design","process","quality","management","estimation"],"type_of_information":["definition","explain","apply"],"tof_statement":{"true":"It improves delivery speed.","false":"It separates teams more."}},{"id":"TRE_05","term":"Microservice Design","keyword":"service","definition":"Builds software as small independent services that can be developed and deployed separately.","simple_terms":"Many small connected application parts","examples":["user svc","order svc","pay svc"],"accepted_terms":[],"difficulty":1,"related_to":["design","process","quality","management","estimation"],"type_of_information":["definition","explain","apply"],"tof_statement":{"true":"Services are independently deployable.","false":"Everything is one large unit."}},{"id":"TRE_06","term":"Container Deployment","keyword":"container","definition":"Packages software and dependencies into isolated units for consistent execution anywhere.","simple_terms":"Portable package for running software","examples":["app image","test image","prod image"],"accepted_terms":["Docker"],"difficulty":1,"related_to":["design","process","quality","management","estimation"],"type_of_information":["definition","explain","apply"],"tof_statement":{"true":"It improves environment consistency.","false":"It removes dependencies."}},{"id":"TRE_07","term":"Internet of Things","keyword":"devices","definition":"Connects physical devices with software systems to collect data and automate actions.","simple_terms":"Smart devices linked to software systems","examples":["smart lock","home sensor","car tracker"],"accepted_terms":["IoT"],"difficulty":1,"related_to":["design","process","quality","management","estimation"],"type_of_information":["definition","explain","apply"],"tof_statement":{"true":"It connects devices and data.","false":"It is only desktop software."}},{"id":"TRE_08","term":"Cybersecurity Focus","keyword":"security","definition":"Builds stronger protection into software to defend against attacks and data breaches.","simple_terms":"Protecting systems and user information","examples":["safe login","data shield","risk scan"],"accepted_terms":[],"difficulty":1,"related_to":["design","process","quality","management","estimation"],"type_of_information":["definition","explain","apply"],"tof_statement":{"true":"Security is part of development.","false":"Security is optional only."}},{"id":"TRE_09","term":"Blockchain Systems","keyword":"ledger","definition":"Uses distributed records for secure, transparent transactions without central control.","simple_terms":"Shared records spread across many nodes","examples":["coin trade","smart deal","chain log"],"accepted_terms":[],"difficulty":1,"related_to":["design","process","quality","management","estimation"],"type_of_information":["definition","explain","apply"],"tof_statement":{"true":"Records are distributed across nodes.","false":"One server controls all."}},{"id":"TRE_10","term":"Remote Collaboration","keyword":"remote","definition":"Supports distributed software teams using online tools for coding, review, and planning.","simple_terms":"Teamwork done from different locations","examples":["video meet","shared repo","online board"],"accepted_terms":[],"difficulty":1,"related_to":["design","process","quality","management","estimation"],"type_of_information":["definition","explain","apply"],"tof_statement":{"true":"Teams can work from anywhere.","false":"Teams must share one office."}},{"id":"COS_01","term":"Cost Estimation","keyword":"budget","definition":"Forecasts money and resources required to complete a software project within constraints.","simple_terms":"Predicting money needed for development","examples":["staff cost","tool cost","time cost"],"accepted_terms":[],"difficulty":1,"related_to":["design","process","quality","management","estimation"],"type_of_information":["definition","explain","apply"],"tof_statement":{"true":"It helps plan project budgets.","false":"It ignores project scope."}},{"id":"COS_02","term":"Effort Estimation","keyword":"effort","definition":"Predicts the amount of human work needed to complete software development tasks.","simple_terms":"Estimating work hours for project tasks","examples":["team hours","coding days","test weeks"],"accepted_terms":[],"difficulty":1,"related_to":["design","process","quality","management","estimation"],"type_of_information":["definition","explain","apply"],"tof_statement":{"true":"It measures required labor.","false":"It counts hardware only."}},{"id":"COS_03","term":"Expert Judgment","keyword":"expert","definition":"Uses experienced professionals to estimate project cost and effort based on knowledge.","simple_terms":"Predictions based on experienced opinion","examples":["lead review","team guess","senior plan"],"accepted_terms":[],"difficulty":1,"related_to":["design","process","quality","management","estimation"],"type_of_information":["definition","explain","apply"],"tof_statement":{"true":"Experience guides the estimate.","false":"No human input is used."}},{"id":"COS_04","term":"Analogous Estimation","keyword":"compare","definition":"Uses similar past projects as a reference to estimate new project cost and duration.","simple_terms":"Comparing with earlier similar projects","examples":["old app","past build","prior task"],"accepted_terms":[],"difficulty":1,"related_to":["design","process","quality","management","estimation"],"type_of_information":["definition","explain","apply"],"tof_statement":{"true":"Past data supports predictions.","false":"History is ignored."}},{"id":"COS_05","term":"Parametric Model","keyword":"formula","definition":"Uses mathematical relationships and project variables to estimate cost and effort.","simple_terms":"Math based prediction of project needs","examples":["size rate","cost rule","staff rule"],"accepted_terms":[],"difficulty":1,"related_to":["design","process","quality","management","estimation"],"type_of_information":["definition","explain","apply"],"tof_statement":{"true":"It uses formulas and variables.","false":"It avoids calculations."}},{"id":"COS_06","term":"Constructive Cost Model","keyword":"model","definition":"A formal estimation model that predicts software effort and cost using project size.","simple_terms":"Standard method for effort prediction","examples":["basic mode","inter mode","detail mode"],"accepted_terms":["COCOMO"],"difficulty":1,"related_to":["design","process","quality","management","estimation"],"type_of_information":["definition","explain","apply"],"tof_statement":{"true":"It estimates using software size.","false":"It measures code quality only."}},{"id":"COS_07","term":"Function Point Count","keyword":"function","definition":"Estimates software size by counting user visible functions and system interactions.","simple_terms":"Sizing by counting delivered functions","examples":["input form","output page","data file"],"accepted_terms":["FP"],"difficulty":1,"related_to":["design","process","quality","management","estimation"],"type_of_information":["definition","explain","apply"],"tof_statement":{"true":"It measures delivered functionality.","false":"It counts only defects."}},{"id":"COS_08","term":"Risk Reserve","keyword":"reserve","definition":"Extra budget or time kept for unexpected issues that may affect project completion.","simple_terms":"Extra allowance for uncertain events","examples":["delay fund","extra days","backup cost"],"accepted_terms":[],"difficulty":1,"related_to":["design","process","quality","management","estimation"],"type_of_information":["definition","explain","apply"],"tof_statement":{"true":"It handles uncertainty in planning.","false":"It removes all risks."}},{"id":"SQA_01","term":"Quality Management","keyword":"quality","definition":"Coordinates policies and activities to ensure software meets standards and user needs.","simple_terms":"Managing how good software is made","examples":["plan check","policy set","goal review"],"accepted_terms":["QM"],"difficulty":1,"related_to":["design","process","quality","management","estimation"],"type_of_information":["definition","explain","apply"],"tof_statement":{"true":"It guides quality goals and control.","false":"It ignores customer needs."}},{"id":"SQA_02","term":"Quality Assurance","keyword":"assure","definition":"Monitors software processes to make sure standards and procedures are followed correctly.","simple_terms":"Checking if work follows set standards","examples":["process audit","rule check","team review"],"accepted_terms":["QA","SQA"],"difficulty":1,"related_to":["design","process","quality","management","estimation"],"type_of_information":["definition","explain","apply"],"tof_statement":{"true":"It focuses on process compliance.","false":"It only fixes finished products."}},{"id":"SQA_03","term":"Quality Control","keyword":"control","definition":"Checks software outputs to find defects and confirm the product meets requirements.","simple_terms":"Testing results to find problems","examples":["bug test","code check","result test"],"accepted_terms":["QC"],"difficulty":1,"related_to":["design","process","quality","management","estimation"],"type_of_information":["definition","explain","apply"],"tof_statement":{"true":"It examines product outputs.","false":"It ignores product defects."}},{"id":"SQA_04","term":"Process Standard","keyword":"standard","definition":"Defined rules that guide how software activities should be performed consistently.","simple_terms":"Rules for doing development tasks","examples":["coding rule","test guide","review flow"],"accepted_terms":[],"difficulty":1,"related_to":["design","process","quality","management","estimation"],"type_of_information":["definition","explain","apply"],"tof_statement":{"true":"It guides how work is done.","false":"It defines user passwords."}},{"id":"SQA_05","term":"Product Standard","keyword":"product","definition":"Quality criteria used to evaluate whether software outputs meet required specifications.","simple_terms":"Rules for checking finished software","examples":["speed check","bug limit","ui rule"],"accepted_terms":[],"difficulty":1,"related_to":["design","process","quality","management","estimation"],"type_of_information":["definition","explain","apply"],"tof_statement":{"true":"It measures software output quality.","false":"It manages employee payroll."}},{"id":"SQA_06","term":"Quality Metric","keyword":"metric","definition":"A measurable value used to evaluate software quality, performance, or reliability.","simple_terms":"Numbers used to judge software results","examples":["bug count","fail rate","uptime log"],"accepted_terms":[],"difficulty":1,"related_to":["design","process","quality","management","estimation"],"type_of_information":["definition","explain","apply"],"tof_statement":{"true":"Metrics provide measurable quality data.","false":"Metrics remove all defects."}},{"id":"SQA_07","term":"Governance Framework","keyword":"govern","definition":"A structured model for aligning software controls, risks, and compliance with business goals.","simple_terms":"Rules for managing control and trust","examples":["audit map","risk guide","control set"],"accepted_terms":["COBIT"],"difficulty":1,"related_to":["design","process","quality","management","estimation"],"type_of_information":["definition","explain","apply"],"tof_statement":{"true":"It aligns controls with objectives.","false":"It replaces programming work."}}]}
